# Build scripts and the toolchain inputs they feed run INSIDE Linux Docker
# containers. They must be checked out with LF endings: on a Windows checkout
# with core.autocrlf=true a CRLF script makes bash-in-Docker fail at line 1
# ($'\r': command not found). Force LF regardless of the host's autocrlf.
*.sh        text eol=lf
*.def       text eol=lf
*.exports   text eol=lf
*.ver       text eol=lf
*.meson     text eol=lf
Dockerfile  text eol=lf

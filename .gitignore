# ─── Build artefacts ─────────────────────────────────────────────────────────
# Everything the build produces lives under one top-level dir:
#   builds/release/   — the libmpv binaries, their build records and license
#                       texts, manifest.json and licenses.zip (the deliverables)
#   builds/logs/      — timestamped per-build logs
#   builds/work/<OS>/[<arch>/] — intermediate trees: downloaded source
#                       tarballs, extracted sources, per-dep build outputs,
#                       install prefixes (large, multi-GB, fully regenerable).
# All recreated on demand — never tracked.
builds/
*.log

# Generic build/prefix/src directories (Docker mounts, ad-hoc builds).
build/
prefix/
src/

# Patch backup files from `patch -b`.
*.orig
*.rej

# User-local ffmpeg component selection, generated by the build TUI's Settings
# page. Per-developer state — never tracked. Delete it (or reset in Settings)
# to restore the curated defaults in scripts/shared/_audio_only.sh.
scripts/shared/_user_overrides.sh

# ─── Codegen ─────────────────────────────────────────────────────────────────
# The lavfi filter codegen lives in a separate repository and is not part of
# this build kit.

# ─── Python ──────────────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd
.venv/
venv/
.python-version

# ─── OS / editor cruft ───────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# JetBrains
.idea/
*.iml

# Editor settings and local notes (not tracked).
.vscode/
docs/
.claude/
CLAUDE.md

# Vim / Emacs swap + backup
*~
*.swp
*.swo
.swap_*

# ─── Local secrets / env ─────────────────────────────────────────────────────
.env
.env.local
*.pem.local
*.key
*.crt

# ─── Misc ────────────────────────────────────────────────────────────────────
# Tarballs / archives left in the working tree
*.tar
*.tar.gz
*.tgz
*.tar.xz
*.tar.bz2
*.zip
# (zip is wide: no zip is tracked. The xcframework and web zips are build
# outputs under builds/, published as release assets.)

# Build environment caches that some toolchains drop in cwd
.cache/
node_modules/

# Compiled binary from `go build`
tui/libmpv-tui

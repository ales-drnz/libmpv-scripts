# ELF version script for libmpv.so (Linux; Android uses mpv_android.ver).
# Passed to ld via -Wl,--version-script,...
#
# Only the public mpv_* C API, plus the mak_pcm_* live PCM API
# (patch_pcm_stream.py), leaks into the .so's dynamic symbol table. All
# statically-linked dep internals (ffmpeg, freetype, fribidi, harfbuzz,
# fontconfig, libass, libplacebo, libsmb2, libxml2, speexdsp, OpenSSL, and
# rubberband in the GPL build) stay local — preventing symbol-poisoning when another Flutter
# plugin loads its own copy of these libraries in the same process.
{
  global:
    mpv_*;
    # The mak_pcm_* API as a glob: lld fails the link, and meson's link
    # tests, on a named symbol that is not defined. The first letters
    # leave out the internal mak_pcm_tap_*.
    mak_pcm_[abcfrsw]*;
  local:
    *;
};

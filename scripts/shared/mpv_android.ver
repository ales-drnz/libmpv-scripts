# ELF version script for libmpv.so on Android.
# Passed to ld via -Wl,--version-script,...
#
# Same surface as scripts/mpv.ver (only the public mpv_* C API exported)
# PLUS JNI_OnLoad — the runtime hook Android calls when libmpv.so is
# brought in via System.loadLibrary("mpv"). Compiled into the binary
# from scripts/patches/mpv/android/android_jni_bridge.c, it forwards the
# JavaVM* to ffmpeg's `av_jni_set_java_vm()` so audiotrack and other
# JNI-dependent components have a working VM by the time the player
# initializes.
{
  global:
    mpv_*;
    JNI_OnLoad;
  local:
    *;
};
